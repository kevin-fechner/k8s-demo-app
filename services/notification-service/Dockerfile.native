FROM ghcr.io/graalvm/native-image-community:21-ol9 AS build
RUN microdnf install -y maven
WORKDIR /build

COPY kafka-events ./kafka-events
COPY notification-service/pom.xml ./notification-service/pom.xml

# Install kafka-events AND download notification-service dependencies in one layer
RUN cd kafka-events && mvn clean install -DskipTests -B && \
    cd ../notification-service && mvn dependency:go-offline -Pnative -B 2>/dev/null || true

COPY notification-service/src ./notification-service/src

RUN cd notification-service && \
    mvn compile spring-boot:process-aot native:compile-no-fork -DskipTests -B

FROM debian:bookworm-slim
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
WORKDIR /app
COPY --from=build /build/notification-service/target/notification-service .
RUN chown -R appuser:appgroup /app
USER appuser
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8083/actuator/health || exit 1
EXPOSE 8083
ENTRYPOINT ["./notification-service"]