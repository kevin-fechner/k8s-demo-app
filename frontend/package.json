    "@angular/platform-browser": "~21.2.10",
    "@angular/platform-server": "~21.2.10",
    "@angular/router": "~21.2.10",
    "@angular/ssr": "^21.2.8",
    "@ngrx/operators": "^21.1.0",
    "@ngrx/signals": "^21.1.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~21.2.8",
    "@angular/cli": "~21.2.8",
    "@angular/compiler-cli": "~21.2.10",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
